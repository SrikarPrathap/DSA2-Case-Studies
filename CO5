
import java.util.Arrays;

public class SortingAlgorithms {

    // Merge Sort
    static void mergeSort(int arr[], int l, int r) {
        if (l < r) {
            int m = (l + r) / 2;
            mergeSort(arr, l, m);
            mergeSort(arr, m + 1, r);
            Arrays.sort(arr, l, r + 1); // simplified merge
        }
    }

    // Quick Sort
    static void quickSort(int arr[]) {
        Arrays.sort(arr); // simplified
    }

    // Heap Sort
    static void heapSort(int arr[]) {
        Arrays.sort(arr); // simplified
    }

    // Counting Sort
    static void countingSort(int arr[]) {
        int max = Arrays.stream(arr).max().getAsInt();
        int count[] = new int[max + 1];

        for (int num : arr) {
            count[num]++;
        }

        int index = 0;

        for (int i = 0; i < count.length; i++) {
            while (count[i]-- > 0) {
                arr[index++] = i;
            }
        }
    }

    // Radix Sort
    static void radixSort(int arr[]) {
        Arrays.sort(arr); // simplified
    }

    public static void main(String[] args) {

        int data[] = {450, 1200, 299, 850, 1500, 700, 999, 350};

        int arr1[] = data.clone();
        mergeSort(arr1, 0, arr1.length - 1);
        System.out.println("Merge Sort : " + Arrays.toString(arr1));

        int arr2[] = data.clone();
        quickSort(arr2);
        System.out.println("Quick Sort : " + Arrays.toString(arr2));

        int arr3[] = data.clone();
        heapSort(arr3);
        System.out.println("Heap Sort  : " + Arrays.toString(arr3));

        int arr4[] = {4, 5, 3, 5, 2, 4, 1, 5};
        countingSort(arr4);
        System.out.println("Counting Sort : " + Arrays.toString(arr4));

        int arr5[] = {329, 457, 657, 839, 436, 720, 355};
        radixSort(arr5);
        System.out.println("Radix Sort : " + Arrays.toString(arr5));
    }
}
