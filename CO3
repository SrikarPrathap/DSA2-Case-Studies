package CO3;

import java.util.*;

class Edge implements Comparable<Edge> {

    int src, dest, weight;

    Edge(int src, int dest, int weight) {
        this.src = src;
        this.dest = dest;
        this.weight = weight;
    }

    public int compareTo(Edge other) {
        return this.weight - other.weight;
    }
}

public class DroneDeliveryNetwork {

    static int V = 6;

    static List<List<Integer>> graph =
            new ArrayList<>();

    static void addEdge(int u, int v) {

        graph.get(u).add(v);
        graph.get(v).add(u);
    }

    // BFS
    static void bfs(int start) {

        boolean visited[] =
                new boolean[V];

        Queue<Integer> queue =
                new LinkedList<>();

        visited[start] = true;
        queue.add(start);

        System.out.print(
                "BFS Traversal: ");

        while (!queue.isEmpty()) {

            int node =
                    queue.poll();

            System.out.print(
                    node + " ");

            for (int nbr :
                    graph.get(node)) {

                if (!visited[nbr]) {

                    visited[nbr] = true;
                    queue.add(nbr);
                }
            }
        }

        System.out.println();
    }

    // DFS
    static void dfs(
            int node,
            boolean visited[]) {

        visited[node] = true;

        System.out.print(
                node + " ");

        for (int nbr :
                graph.get(node)) {

            if (!visited[nbr])
                dfs(nbr,
                    visited);
        }
    }

    // Prim's MST
    static void primMST(
            int matrix[][]) {

        int parent[] =
                new int[V];

        int key[] =
                new int[V];

        boolean mst[] =
                new boolean[V];

        Arrays.fill(
                key,
                Integer.MAX_VALUE);

        key[0] = 0;
        parent[0] = -1;

        for (int count = 0;
             count < V - 1;
             count++) {

            int u = -1;

            int min =
                Integer.MAX_VALUE;

            for (int i = 0;
                 i < V;
                 i++) {

                if (!mst[i] &&
                    key[i] < min) {

                    min = key[i];
                    u = i;
                }
            }

            mst[u] = true;

            for (int v = 0;
                 v < V;
                 v++) {

                if (matrix[u][v] != 0
                        &&
                    !mst[v]
                        &&
                    matrix[u][v]
                            < key[v]) {

                    parent[v] = u;

                    key[v] =
                            matrix[u][v];
                }
            }
        }

        System.out.println(
                "\nPrim's MST:");

        int total = 0;

        for (int i = 1;
             i < V;
             i++) {

            System.out.println(
                    parent[i]
                    + " - "
                    + i
                    + " : "
                    + matrix[i]
                             [parent[i]]);

            total +=
                matrix[i]
                      [parent[i]];
        }

        System.out.println(
                "Total Cost = "
                + total);
    }

    // Union Find
    static int find(
            int parent[],
            int i) {

        if (parent[i] == i)
            return i;

        return find(
                parent,
                parent[i]);
    }

    static void union(
            int parent[],
            int x,
            int y) {

        int xset =
            find(parent,x);

        int yset =
            find(parent,y);

        parent[xset] =
            yset;
    }

    // Kruskal MST
    static void kruskalMST(
            List<Edge> edges) {

        Collections.sort(
                edges);

        int parent[] =
                new int[V];

        for (int i = 0;
             i < V;
             i++)
            parent[i] = i;

        int edgeCount = 0;

        int total = 0;

        System.out.println(
                "\nKruskal MST:");

        for (Edge e :
                edges) {

            int x =
                find(parent,
                     e.src);

            int y =
                find(parent,
                     e.dest);

            if (x != y) {

                System.out.println(
                        e.src +
                        " - " +
                        e.dest +
                        " : " +
                        e.weight);

                total +=
                    e.weight;

                union(parent,
                      x,
                      y);

                edgeCount++;

                if (edgeCount ==
                    V - 1)
                    break;
            }
        }

        System.out.println(
                "Total Cost = "
                + total);
    }

    public static void main(
            String[] args) {

        for (int i = 0;
             i < V;
             i++)
            graph.add(
                new ArrayList<>());

        addEdge(0,1);
        addEdge(0,2);
        addEdge(1,3);
        addEdge(2,3);
        addEdge(2,4);
        addEdge(3,5);

        bfs(0);

        System.out.print(
                "DFS Traversal: ");

        boolean visited[] =
                new boolean[V];

        dfs(0,visited);

        int matrix[][] = {

            {0,4,2,0,0,0},
            {4,0,5,10,0,0},
            {2,5,0,3,7,0},
            {0,10,3,0,1,6},
            {0,0,7,1,0,8},
            {0,0,0,6,8,0}
        };

        primMST(matrix);

        List<Edge> edges =
                new ArrayList<>();

        edges.add(
            new Edge(0,1,4));

        edges.add(
            new Edge(0,2,2));

        edges.add(
            new Edge(1,2,5));

        edges.add(
            new Edge(1,3,10));

        edges.add(
            new Edge(2,3,3));

        edges.add(
            new Edge(2,4,7));

        edges.add(
            new Edge(3,4,1));

        edges.add(
            new Edge(3,5,6));

        edges.add(
            new Edge(4,5,8));

        kruskalMST(edges);
    }
}
